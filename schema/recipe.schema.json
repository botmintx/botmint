{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "attributes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "trait_type": {
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "trait_type",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "collection": {
      "minLength": 1,
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "dna": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "edition": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "engineVersion": {
      "minLength": 1,
      "type": "string"
    },
    "gettingStarted": {
      "const": "getting-started",
      "type": "string"
    },
    "job": {
      "minLength": 1,
      "type": "string"
    },
    "memories": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 3,
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "plugins": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "connector": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "marketplaceId": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "connector",
          "label",
          "marketplaceId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "minLength": 1,
      "type": "string"
    },
    "routines": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "deliveryLine": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "prompt": {
            "minLength": 1,
            "type": "string"
          },
          "schedule": {
            "type": [
              "string",
              "null"
            ]
          },
          "trigger": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "event": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "event"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "schedule",
          "trigger",
          "prompt",
          "deliveryLine"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "skills": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "body"
        ],
        "type": "object"
      },
      "minItems": 4,
      "type": "array"
    },
    "tokenId": {
      "pattern": "^#\\d{4,5}$",
      "type": "string"
    },
    "traits": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "autonomy": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "avatar": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "cadence": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "connectors": {
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "domain": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "output": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "persona": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "skills": {
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "archetype",
        "domain",
        "persona",
        "skills",
        "cadence",
        "connectors",
        "autonomy",
        "output",
        "avatar"
      ],
      "type": "object"
    },
    "visibility": {
      "const": "public",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "collection",
    "tokenId",
    "edition",
    "dna",
    "engineVersion",
    "name",
    "description",
    "job",
    "policy",
    "traits",
    "attributes",
    "skills",
    "routines",
    "memories",
    "plugins",
    "gettingStarted",
    "visibility"
  ],
  "type": "object"
}
