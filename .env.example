# Leave this blank. botmint reads XAI_API_KEY from the environment only.
# Polish refuses to run when CI=true, and a real call also needs
# --i-understand-this-costs-money. Do not commit a key.
XAI_API_KEY=

# Optional. Tests point this at a local mock. Never set it to call a paid API in CI.
# XAI_BASE_URL=https://api.x.ai/v1
